<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group shared with the TazkiraWidget extension.
	     Allows writing prayer snapshot data to UserDefaults(suiteName:)
	     so the widget extension can read it without any IPC.
	     This identifier must also be declared in the widget extension's
	     TazkiraWidget.entitlements file. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.moaz.tazkira</string>
	</array>
</dict>
</plist>
